# RESQIVO backend settings (placeholders only; never commit real values).
# The application reads these from the environment; export them in your shell.

# Retrieval (see docs/rag.md). Relative paths resolve from the current directory.
RESQIVO_CHROMA_DIR=../data/index/chroma
RESQIVO_CHROMA_COLLECTION=resqivo_knowledge
# hashing (offline, lexical, for development) or onnx-minilm (needs a cached model)
RESQIVO_EMBEDDING_PROVIDER=hashing
# Allow onnx-minilm to download its model (about 83 MB) if not cached. Keep false
# except for a deliberate, supervised index build.
RESQIVO_ALLOW_MODEL_DOWNLOAD=false

# Model provider: Google Gemini (Gemini Developer API). Backend only: never put
# this key in the frontend or in any NEXT_PUBLIC_ variable. Leave it empty here;
# set it only in your shell or in a local backend/.env (ignored by Git) exported
# before starting the server. Without it, /answer, /review and /draft-plan return
# 503. GEMINI_API_KEY and Vertex AI settings are not used.
GOOGLE_API_KEY=
# Stable Gemini model with function calling and structured outputs.
RESQIVO_LLM_MODEL=gemini-3.8-flash
RESQIVO_QA_TOP_K=4
# Cosine distance cut-off (0-2); not yet calibrated for a real embedding model.
RESQIVO_QA_MAX_DISTANCE=1.0

# Model-initiated tool calling for /review and /draft-plan (docs/workflow.md
# section 10). Off by default; not yet verified against the live Gemini API.
RESQIVO_TOOL_CALLING=false
# Tool calls per request, 1-8. Values above the hard limit of 8 are rejected.
RESQIVO_MAX_TOOL_CALLS=4

# Request limits (docs/stress-testing.md section 2). Values outside the bounds
# make every endpoint return 503 until fixed.
# Maximum request body in bytes, 16384-8388608 (default 1 MiB); larger -> 413.
RESQIVO_MAX_BODY_BYTES=1048576
# Per-request time budget in seconds, 1-600; when used up -> 504.
RESQIVO_REQUEST_TIMEOUT_SECONDS=120

# Simulated incident feed (docs/incidents.md). SQLite file for incidents;
# the default is data/incidents/incidents.db at the repository root.
RESQIVO_INCIDENT_DB=../data/incidents/incidents.db
